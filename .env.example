# ==========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (MVP)
# ==========================================

# ------------------------------------------
# BACKEND - API (apps/api) & DATABASE (packages/db)
# ------------------------------------------
# URL de conexión a la base de datos PostgreSQL
DATABASE_URL=postgres://admin:juani123@localhost:5432/sistema_restaurantes

# Puerto donde corre el servidor de la API (Hono)
PORT=3001

# Secreto para Better Auth (generar una cadena larga y aleatoria en producción)
BETTER_AUTH_SECRET=un-secreto-largo-y-random-para-desarrollo

# URL base de Better Auth (debe apuntar al backend)
BETTER_AUTH_URL=http://localhost:3001/api/auth

# URL del Frontend cliente
CLIENT_URL=http://localhost:3000

# ------------------------------------------
# FRONTEND - WEB APP (apps/web)
# ------------------------------------------
# URL pública de la API a la que se conectará el cliente
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública de Better Auth (debe ser la misma que BETTER_AUTH_URL del backend)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001/api/auth

# ------------------------------------------
# CLOUDFLARE R2 - STORAGE (apps/api)
# ------------------------------------------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-public-bucket-url.r2.dev
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev
